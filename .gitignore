# ============================================================
# Development AAPC Medical Coding - Git Ignore Rules
# ============================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
PROJECT_STRUCTURE.txt

# Testing
/coverage

# Next.js build output
/.next/
/out/

# Production build
/build

# Environment variables and secrets
.env
.env.*
!.env.example

# Miscellaneous
.DS_Store
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Deployment
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Generated Prisma Client
/src/generated/prisma/


