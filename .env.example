# ============================================================
# Development AAPC Medical Coding
# Environment Variables Template
# ============================================================
# Copy this file to .env and configure values for your environment.
# Never store real passwords, tokens, or API keys in this file.

# ------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------

DATABASE_URL="mysql://<DATABASE_USER>:<DATABASE_PASSWORD>@127.0.0.1:3306/<DATABASE_NAME>"

DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3306"
DATABASE_USER="your_local_database_user"
DATABASE_PASSWORD="replace_with_your_local_database_password"
DATABASE_NAME="database name"

# ------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------

NEXT_PUBLIC_SITE_NAME="project name"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------
# Authentication and Security
# ------------------------------------------------------------

AUTH_SECRET="replace_with_a_unique_auth_secret"
JWT_SECRET="replace_with_a_unique_jwt_secret"

# ------------------------------------------------------------
# Email Configuration
# ------------------------------------------------------------

RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="project_name<noreply@example.com>"